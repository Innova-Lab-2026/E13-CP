PORT=3000
NODE_ENV=development
JWT_SECRET=pega_aqui_una_clave_aleatoria

# Secreto de servicio para las operaciones administrativas del backend
# (sincronización de la lista oficial de LOTBA). Generá uno aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=pega_aqui_otro_secreto_aleatorio

# --- Iniciar sesión con Google (opcional) ---------------------------------
# Sin estas tres variables, GET /api/auth/google/config responde
# { "enabled": false } y la app no muestra el botón "Continuar con Google".
#
# Cómo crear el cliente OAuth:
#   1. Google Cloud Console > APIs y servicios > Pantalla de consentimiento de
#      OAuth: configurala (tipo "Externo") con los scopes openid, email y profile.
#   2. APIs y servicios > Credenciales > Crear credenciales > ID de cliente de
#      OAuth > tipo "Aplicación web". Uno solo sirve para la web y para Android:
#      no hace falta un cliente de Android.
#   3. En "URIs de redireccionamiento autorizados" agregá:
#        https://baprotege-api.vercel.app/api/auth/google/callback
#        http://localhost:3000/api/auth/google/callback
#      ("Orígenes de JavaScript autorizados" puede quedar vacío.)
#   4. Copiá el ID y el secreto del cliente acá abajo. El secreto nunca va al repo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tiene que coincidir exacto con una de las URIs registradas en el paso 3.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Prefijos permitidos para la URL a la que vuelve la app con el código,
# separados por coma. Un prefijo http(s) que es solo el origen se completa con
# "/" para fijar el host. Si no se define, se usan estos:
# GOOGLE_RETURN_URL_PREFIXES=baprotege://auth/google,https://baprotege.vercel.app/app/auth/google
# y, solo fuera de producción (sin NODE_ENV=production ni VERCEL), también
# http://localhost:8081/ para Expo web en local.
